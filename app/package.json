{
    "name": "@fiftyone/fiftyone",
    "version": "0.0.0",
    "productName": "FiftyOne",
    "license": "Apache-2.0",
    "private": true,
    "main": "index.js",
    "scripts": {
        "build": "concurrently -g \"yarn:check:strict\" \"yarn workspace @fiftyone/app build\"",
        "build:win32": "yarn check:strict && yarn workspace @fiftyone/app build:win32",
        "check:strict": "echo 'Running strict lint checks...' && yarn workspace @fiftyone/multimodal check",
        "check": "yarn workspace @fiftyone/multimodal check",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "typecheck:error-count": "yarn typecheck | grep -c \"error TS\"",
        "compile": "yarn relay-compiler",
        "dev": "yarn workspace @fiftyone/app dev",
        "dev:py": "node dev.mjs py",
        "dev:wpy": "node dev.mjs wpy",
        "doc": "./gen-docs.sh",
        "lint:prettify": "prettier --config ../.prettierrc.js --ignore-path ../.prettierignore  --write \"packages/**/*.(ts|js|jsx|tsx|json|css|scss)\"",
        "format": "cd .. && prettier --write --ignore-path .prettierignore \"**/*.{ts,js,jsx,tsx,json,css,scss,md}\"",
        "format:check": "cd .. && prettier --check --ignore-path .prettierignore \"**/*.{ts,js,jsx,tsx,json,css,scss,md}\"",
        "start": "yarn workspace @fiftyone/app start",
        "storybook": "yarn workspace @fiftyone/components storybook",
        "test": "yarn vitest run --no-coverage",
        "test:coverage": "yarn vitest run --coverage",
        "test-ui": "yarn vitest --ui --coverage",
        "gen:schema": "strawberry export-schema fiftyone.server.app:schema > schema.graphql"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.11.0",
        "@testing-library/dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/colormap": "^2",
        "@types/react-plotly.js": "^2.6.3",
        "@typescript-eslint/eslint-plugin": "^5.44.0",
        "@typescript-eslint/parser": "^5.44.0",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "babel-plugin-relay": "catalog:",
        "concurrently": "^7.2.1",
        "dependency-cruiser": "^16.10.4",
        "eslint": "catalog:",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-only-warn": "^1.0.3",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.31.11",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jsdom": "^20.0.2",
        "prettier": "catalog:",
        "react-dom": "catalog:",
        "relay-compiler": "catalog:",
        "relay-runtime": "catalog:",
        "typedoc": "^0.23.21",
        "typescript": "catalog:",
        "typescript-plugin-css-modules": "^5.0.2",
        "vite": "catalog:",
        "vite-plugin-relay": "catalog:",
        "vite-plugin-wasm": "catalog:",
        "vitest": "catalog:"
    },
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
    "dependencies": {
        "@emotion/react": "catalog:",
        "@emotion/styled": "catalog:",
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "@rjsf/core": "^5.24.13",
        "@rjsf/mui": "^5.24.13",
        "@rjsf/utils": "^5.24.13",
        "@rjsf/validator-ajv8": "^5.24.13",
        "colormap": "catalog:",
        "pixi-viewport": "^6.0.3",
        "pixi.js": "^8.13.1",
        "plotly.js": "^3.1.1",
        "react": "catalog:",
        "react-player": "^2.16.0",
        "react-plotly.js": "^2.6.0"
    },
    "resolutions": {
        "@types/mapbox-gl": "2.7.21",
        "@types/react": "18.3.12",
        "@voxel51/voodo": "^0.1.0",
        "brace-expansion": "^5.0.6",
        "minimatch": "9.0.7",
        "prettier": "~3.8.4",
        "protobufjs": "^7.6.4",
        "three-stdlib": "^2.36.1"
    }
}
