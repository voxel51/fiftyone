diff --git a/build/three.webgpu.js b/build/three.webgpu.js
index 31ff163d67f4cc5dec060a11bc7151c64f949fd9..fd5639b5440bbe60f3cf76a9c593353564a45ae0 100644
--- a/build/three.webgpu.js
+++ b/build/three.webgpu.js
@@ -29251,7 +29251,10 @@ class RenderObject {
 				// geometry attribute
 				attribute = geometry.getAttribute( nodeAttribute.name );
 
-				attributesId[ nodeAttribute.name ] = attribute.version;
+				// TEMPORARY vendored backport of upstream #32700 (shipped after
+				// r182): store ids, not versions — needsGeometryUpdate compares
+				// ids, so the mismatch re-collected attributes every frame.
+				attributesId[ nodeAttribute.name ] = attribute.id;
 
 			}
 
@@ -30236,7 +30239,6 @@ class Geometries extends DataMap {
 			this.info.memory.geometries --;
 
 			const index = geometry.index;
-			const geometryAttributes = renderObject.getAttributes();
 
 			if ( index !== null ) {
 
@@ -30244,9 +30246,15 @@ class Geometries extends DataMap {
 
 			}
 
-			for ( const geometryAttribute of geometryAttributes ) {
+			// TEMPORARY vendored fix — drop this patch once
+			// https://github.com/mrdoob/three.js/pull/33939 ships in a release.
+			// Delete the disposed geometry's own attributes. Reading them off
+			// the render object instead is wrong once the object was switched
+			// to another geometry: the dispose of the old geometry would then
+			// delete the LIVE geometry's GPU buffers (and leak its own).
+			for ( const name of Object.keys( geometry.attributes ) ) {
 
-				this.attributes.delete( geometryAttribute );
+				this.attributes.delete( geometry.attributes[ name ] );
 
 			}
 
@@ -53885,11 +53893,20 @@ class Nodes extends DataMap {
 		if ( object.isRenderObject ) {
 
 			const nodeBuilderState = this.get( object ).nodeBuilderState;
-			nodeBuilderState.usedTimes --;
 
-			if ( nodeBuilderState.usedTimes === 0 ) {
+			// TEMPORARY vendored backport of upstream #33160 (ships in r184):
+			// a render object disposed after its renderer (or one whose nodes
+			// were never built) has no node builder state; decrementing through
+			// undefined threw mid-dispose and poisoned every later frame.
+			if ( nodeBuilderState !== undefined ) {
 
-				this.nodeBuilderCache.delete( this.getForRenderCacheKey( object ) );
+				nodeBuilderState.usedTimes --;
+
+				if ( nodeBuilderState.usedTimes === 0 ) {
+
+					this.nodeBuilderCache.delete( this.getForRenderCacheKey( object ) );
+
+				}
 
 			}
 
