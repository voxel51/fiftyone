{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "dependencyDashboard": false,
    "baseBranches": ["main"],
    "gitAuthor": "voxel51-bot <bot@voxel51.com>",
    "schedule": ["* * * * 3"],
    "labels": ["dependencies"],
    "enabledManagers": [
        "pip_requirements",
        "pip_setup",
        "github-actions",
        "npm"
    ],
    "pip_requirements": {
        "managerFilePatterns": [
            "/(^|/)[\\w-]*requirements([-._]\\w+)?\\.(txt|pip)$/",
            "/(^|/)requirements/[^/]+\\.(txt|pip)$/"
        ]
    },
    "ignoreDeps": [
        "pymongo",
        "motor",
        "mongoengine",
        "fiftyone-brain",
        "fiftyone-db",
        "voxel51-eta"
    ],
    "packageRules": [
        {
            "matchManagers": ["pip_requirements", "pip_setup"],
            "groupName": "stable-python-packages",
            "addLabels": ["python"]
        },
        {
            "matchManagers": ["github-actions"],
            "groupName": "github-actions",
            "addLabels": ["github-actions"]
        },
        {
            "matchManagers": ["npm"],
            "addLabels": ["app"]
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["patch", "pin", "digest"],
            "groupName": "app-dependencies"
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["minor"],
            "matchCurrentVersion": "<1.0.0",
            "enabled": false
        },
        {
            "matchManagers": ["github-actions"],
            "matchDepNames": ["python"],
            "enabled": false
        },
        {
            "matchManagers": ["npm"],
            "matchDepNames": ["minimatch", "brace-expansion"],
            "enabled": false
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["dependencies", "security"]
    },
    "osvVulnerabilityAlerts": true
}
