{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "dependencyDashboard": false,
    "baseBranches": ["develop"],
    "gitAuthor": "voxel51-bot <bot@voxel51.com>",
    "rangeStrategy": "widen",
    "schedule": ["* * * * 3"],
    "labels": ["dependencies"],
    "enabledManagers": [
        "pep621",
        "pre-commit",
        "dockerfile",
        "github-actions",
        "npm",
        "custom.regex"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["* * * * 3"]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^pyproject\\.toml$/"],
            "matchStrings": [
                "\\[tool\\.ruff\\][\\s\\S]*?required-version = \"==(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "ruff",
            "datasourceTemplate": "pypi"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^pyproject\\.toml$/",
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "\\[tool\\.uv\\][\\s\\S]*?required-version = \"==(?<currentValue>[^\"]+)\"",
                "uses: astral-sh/setup-uv@[^\\n]+\\n(?:[^\\n]*\\n){0,8}\\s+version: \"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "uv",
            "datasourceTemplate": "github-releases",
            "packageNameTemplate": "astral-sh/uv",
            "versioningTemplate": "semver-coerced"
        }
    ],
    "ignoreDeps": [
        "pymongo",
        "motor",
        "mongoengine",
        "fiftyone-brain",
        "fiftyone-db",
        "voxel51-eta"
    ],
    "packageRules": [
        {
            "matchManagers": ["pep621"],
            "groupName": "stable-python-packages",
            "addLabels": ["python"]
        },
        {
            "matchPackageNames": ["ruff"],
            "groupName": "ruff-toolchain",
            "addLabels": ["python"]
        },
        {
            "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"],
            "groupName": "uv-toolchain",
            "addLabels": ["python"]
        },
        {
            "matchManagers": ["github-actions"],
            "groupName": "github-actions",
            "addLabels": ["github-actions"]
        },
        {
            "matchManagers": ["npm"],
            "groupName": "app-dependencies",
            "addLabels": ["app"]
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["dependencies", "security"]
    },
    "osvVulnerabilityAlerts": true
}
